        "objective_terms": [
          "August 2025",
          "September 2025",
          "category",
          "sales"
        ]
      },
      "tools": {
        "expected": [
          "date_coverage_check",
          "read_only_sql"
        ],
        "exact_match": true,
        "required_tables": [
          "orders",
          "order_items",
          "products"
        ]
      },
      "arguments": {
        "required_sql_patterns": [
          "orders",
          "order_items",
          "products",
          "2025-08",
          "2025-09",
          "delivered"
        ],
        "forbidden_sql_patterns": [
          "DROP\\s+TABLE",
          "DELETE\\s+FROM",
          "UPDATE\\s+"
        ],
        "require_sql_verification": true
      },
      "efficiency": {
        "max_model_calls": 14,
        "max_tool_calls": 12,
        "max_total_steps": 35,
        "max_planner_repairs": 0
