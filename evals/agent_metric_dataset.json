        "workflow_status": "verified",
        "jev_actions": [
          "ALLOW"
        ],
        "plan_status": "ready",
        "requires_answer": true,
        "output_guard": "ALLOW",
        "evidence_types": [
          "sql"
        ],
        "require_citations": true,
        "answer_terms": [
          "August 2025",
          "September 2025",
          "category",
          "percentage",
          "reconcil",
          "cause"
        ]
      },
      "plan": {
        "agents": [
          "data_analyst"
        ],
        "required_sources": [
          "orders",
          "order_items",
          "products"
