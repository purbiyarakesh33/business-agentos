    {
      "case_id": "report_category_sales",
      "split": "development",
      "component": "answer_quality",
      "query": "Compare delivered net product sales by product category in September 2025 versus August 2025. Show each category's dollar and percentage change, rank the largest declines, reconcile category changes to the overall change, cite SQL evidence, and state whether this proves a cause.",
      "expected": {
        "required_claims": [
          "Overall delivered net sales changed from USD 18,318.63 in August 2025 to USD 11,008.18 in September 2025.",
          "The overall dollar change is USD -7,310.45 and the percentage change is -39.91%.",
          "Category dollar changes: Storage -2,800.75; Decor -1,930.93; Bedding -1,156.62; Kitchen -991.80; Lighting -430.35.",
          "Category dollar changes sum to the overall dollar change."
        ],
        "required_caveats": [
          "The result is descriptive and does not establish a cause.",
          "The measure uses order_items.line_net_sales for delivered orders; shipping and later refunds are excluded."
        ],
        "forbidden_claims": [
          "Inventory, marketing, competitor, or supply-chain changes caused the decline."
        ],
        "relevant_sources": [
          "orders",
          "order_items",
          "products"
        ],
        "numeric_facts": [
          18318.63,
          11008.18,
          -7310.45,
          -39.91,
          -2800.75,
          -1930.93,
          -1156.62,
          -991.8,
          -430.35
        ]
      }
    },
    {
      "case_id": "report_sales_cause_boundary",
      "split": "holdout",
      "component": "answer_quality",
      "query": "Why did delivered sales decline in September 2025? Check available inventory, paid-search, and fulfillment data.",
      "expected": {
        "required_claims": [
          "Report only observed period changes supported by available tables.",
          "Co-occurring changes show association and do not prove which factor caused the decline."
        ],
        "required_caveats": [
          "The synthetic scenario does not establish a causal relationship."
        ],
        "forbidden_claims": [
          "Any observed factor caused the decline without a causal identification design."
        ],
        "relevant_sources": [
          "orders",
          "order_items",
          "inventory_snapshots",
          "marketing_campaigns",
          "fulfillment"
        ],
        "numeric_facts": []
      }
    },
    {
      "case_id": "report_customer_repeat_segments_dev",
      "split": "development",
      "component": "answer_quality",
      "query": "For July through December 2025, which customer segments had the lowest repeat-purchase rate? Define repeat purchase using delivered orders and cite the order-history evidence.",
      "expected": {
        "required_claims": [
          "The segment-level repeat-purchase rates use customers with at least one delivered order in July through December 2025 as the denominator and customers with at least two delivered orders in that window as repeat purchasers.",
          "Premium has 24 repeat customers among 68 active customers (35.29%) and Value has 54 among 153 (35.29%); these segments tie for the lowest rate.",
          "Core has 99 repeat customers among 261 active customers (37.93%).",
          "This is a descriptive segment comparison and does not establish why repeat purchasing differs."
        ],
        "required_caveats": [
          "Customer segment values are current customer-row values, not historical snapshots.",
          "Repeat purchase is defined within the selected six-month window and is not lifetime returning status."
        ],
        "forbidden_claims": [
          "The segment comparison proves why customers repeat or stop purchasing.",
          "Premium or Value customers have a lower lifetime returning rate based on this within-window result."
        ],
        "relevant_sources": ["customers", "orders"],
        "numeric_facts": [68, 24, 35.29, 153, 54, 261, 99, 37.93]
      }
    },
    {
      "case_id": "report_carrier_ontime_dev",
      "split": "development",
      "component": "answer_quality",
      "query": "Compare delivered on-time rates by carrier in September 2025 and August 2025.",
      "expected": {
        "required_claims": [
          "GroundLine decreased from 84.38% (27 of 32 delivered shipments) in August to 79.31% (23 of 29) in September, a 5.07 percentage-point decline.",
          "ParcelNorth decreased from 88.10% (37 of 42) to 80.00% (12 of 15), an 8.10 percentage-point decline.",
          "SwiftPost decreased from 95.24% (40 of 42) to 87.50% (28 of 32), a 7.74 percentage-point decline.",
          "ParcelNorth had the largest decline in on-time rate, but these observed delivery rates do not prove that delivery performance caused a sales change."
        ],
        "required_caveats": [
          "The denominator is delivered shipments with both actual and promised delivery dates, grouped by fulfillment ship month.",
          "The data is descriptive and does not establish a causal effect."
        ],
        "forbidden_claims": [
          "Carrier delivery delays caused the sales decline."
        ],
        "relevant_sources": ["orders", "fulfillment"],
        "numeric_facts": [84.38, 27, 32, 79.31, 23, 29, 5.07, 88.10, 37, 42, 80.00, 12, 15, 8.10, 95.24, 40, 87.50, 28, 7.74]
      }
    },
    {
      "case_id": "report_forecast_jan_mar_2026_dev",
      "split": "development",
      "component": "answer_quality",
      "query": "As of 2025-12-31, retrospectively forecast delivered net product sales for the next three months using only data through that date; compare models and report uncertainty and limitations.",
      "expected": {
        "required_claims": [
          "The forecast uses delivered net product sales from orders and order_items and reports January, February, and March 2026 estimates with uncertainty bands.",
          "The report compares forecasting methods using rolling-origin backtests and describes the forecast as retrospective because those target months have passed.",
          "The forecast is an estimate based on historical data and does not prove future results or causes."
        ],
        "required_caveats": [
          "Uncertainty bands are empirical estimates, not guaranteed bounds.",
          "This retrospective evaluation uses a data cutoff of December 2025."
        ],
        "forbidden_claims": [
          "The forecast is an observed actual result for January, February, or March 2026."
        ],
        "relevant_sources": ["orders", "order_items"],
        "numeric_facts": []
      }
    },
