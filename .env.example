# Featherless API key used by Jev, the planner, specialists, chat, and embeddings.
FEATHERLESS_API_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_JEV_BASE_URL=https://simple-jev-demo-api.featherless.ai/v1
FEATHERLESS_JEV_MODEL=featherless-ai/Qwen3.6-35B-A3B-classifier
FEATHERLESS_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_PLANNER_MODEL=zai-org/GLM-5.3-Flash
FEATHERLESS_PLANNER_REASONING_EFFORT=high
FEATHERLESS_ANALYST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Compose overrides this URL inside the app container to use the ragdb service.
# This localhost URL is for running app.py directly on Windows.
RAG_DATABASE_URL=postgresql://agentos:agentos-local-demo-only@localhost:5433/agentos_rag
RAG_TENANT_ID=demo

# Local demo password only. Set a strong URL-safe value before using outside localhost.
POSTGRES_PASSWORD=agentos-local-demo-only

# Public deployment protections (leave disabled for ordinary local development).
PUBLIC_DEMO_MODE=false
PUBLIC_DAILY_REQUEST_LIMIT=20
PUBLIC_HOURLY_REQUEST_LIMIT=6
